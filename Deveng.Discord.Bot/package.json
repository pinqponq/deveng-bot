{
  "name": "deveng-bot",
  "version": "1.0.0",
  "description": "Deveng Bot — Discord bot runtime (API + PostgreSQL via EF)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "register-commands": "ts-node src/scripts/registerCommands.ts",
    "get-client-id": "ts-node src/scripts/getClientId.ts",
    "test": "vitest run"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "lavalink-client": "^2.10.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.3",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "cross-spawn": "7.0.6",
    "glob": "10.5.0",
    "minimatch": "10.2.5",
    "tar": "7.5.11",
    "path-to-regexp": "6.3.0",
    "undici": "^7.28.0",
    "ws": "^8.21.1",
    "postcss": "^8.5.25",
    "brace-expansion": "^2.1.3"
  }
}
