<?xml version="1.0" encoding="utf-8"?>

<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="/tmp/nlog-internal.log">

  <extensions>
    <add assembly="NLog.Targets.ElasticSearch" />
  </extensions>

  <!--
    PII / token / kimlik bilgisi maskeleme.
    Aşağıdaki regex katmanları, log mesaj ve exception içinde sıkça görülen kimlik
    bilgilerini "***REDACTED***" ile değiştirir. Yeni desen eklerken pattern testlerini
    güncellemeyi unutmayın.
  -->
  <variable name="redactedMessage"
            value="${replace:searchFor=(?i)(authorization\\s*[:=]\\s*bearer\\s+)[A-Za-z0-9._\\-+/=]+:replaceWith=$${1}***REDACTED***:regex=true:inner=${replace:searchFor=(?i)(x-bot-token\\s*[:=]\\s*)[A-Za-z0-9._\\-+/=]+:replaceWith=$${1}***REDACTED***:regex=true:inner=${replace:searchFor=(?i)(x-bot-signature\\s*[:=]\\s*)[A-Fa-f0-9]+:replaceWith=$${1}***REDACTED***:regex=true:inner=${replace:searchFor=(?i)(cookie\\s*[:=]\\s*)[^,\\s]+:replaceWith=$${1}***REDACTED***:regex=true:inner=${replace:searchFor=[A-Za-z0-9_-]{24,28}\\.[A-Za-z0-9_-]{6,7}\\.[A-Za-z0-9_-]{27,}:replaceWith=***DISCORD_TOKEN***:regex=true:inner=${replace:searchFor=https://discord(?:app)?\\.com/api/webhooks/\\d+/[A-Za-z0-9_\\-]+:replaceWith=https://discord.com/api/webhooks/***REDACTED***:regex=true:inner=${replace:searchFor=(?i)(card_number|cardno|cc_number|pan|cvv|cvc|expiry_month|expiry_year|exp_month|exp_year|cc_owner)\\s*[:=]\\s*[^&,\\s\\}\\\"]+:replaceWith=$${1}=***PCI***:regex=true:inner=${replace:searchFor=\\b\\d{4}[\\s\\-]\\d{4}[\\s\\-]\\d{4}[\\s\\-]\\d{1,4}\\b:replaceWith=****-****-****-****:regex=true:inner=${message}}}}}}}}}" />

  <variable name="redactedException"
            value="${replace:searchFor=(?i)(authorization\\s*[:=]\\s*bearer\\s+)[A-Za-z0-9._\\-+/=]+:replaceWith=$${1}***REDACTED***:regex=true:inner=${replace:searchFor=[A-Za-z0-9_-]{24,28}\\.[A-Za-z0-9_-]{6,7}\\.[A-Za-z0-9_-]{27,}:replaceWith=***DISCORD_TOKEN***:regex=true:inner=${replace:searchFor=(?i)(card_number|cardno|cc_number|pan|cvv|cvc|expiry_month|expiry_year|exp_month|exp_year|cc_owner)\\s*[:=]\\s*[^&,\\s\\}\\\"]+:replaceWith=$${1}=***PCI***:regex=true:inner=${replace:searchFor=\\b\\d{4}[\\s\\-]\\d{4}[\\s\\-]\\d{4}[\\s\\-]\\d{1,4}\\b:replaceWith=****-****-****-****:regex=true:inner=${exception:format=toString}}}}}" />

  <targets async="true">

    <target name="console"
            xsi:type="Console"
            layout="${date:format=HH\:mm\:ss} [${level:upperCase=true:padding=-5}] ${logger:shortName=true} | ${redactedMessage} ${redactedException}" />

    <target name="elastic"
            xsi:type="ElasticSearch"
            uri="http://elasticsearch:9200"
            index="deveng-discord-api-logs-${date:format=yyyy.MM.dd}"
            includeAllProperties="false"
            documentType=""
            disableAutomaticProxyDetection="true">

      <field name="@timestamp" layout="${date:universalTime=true:format=o}" />
      <field name="level"      layout="${level:upperCase=true}" />
      <field name="logger"     layout="${logger}" />
      <field name="message"    layout="${redactedMessage}" />
      <field name="exception"  layout="${redactedException}" />
      <field name="app"        layout="deveng-discord-api" />

    </target>

  </targets>

  <rules>
    <logger name="Deveng.Security" minlevel="Info" writeTo="console,elastic" final="true" />
    <logger name="Microsoft.*" minlevel="Warning" writeTo="console,elastic" final="true" />
    <logger name="System.*"    minlevel="Warning" writeTo="console,elastic" final="true" />
    <logger name="*"           minlevel="Debug"   writeTo="console,elastic" />
  </rules>

</nlog>
